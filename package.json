{
  "name": "arena-ai-desktop",
  "version": "1.0.0",
  "description": "Удобное десктоп-приложение для Arena AI",
  "main": "src/main.js",
  "author": {
    "name": "Arena AI Desktop",
    "email": "desktop@arena.ai"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:all": "electron-builder --linux --win --mac"
  },
  "build": {
    "appId": "ai.arena.desktop",
    "productName": "Arena AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Network",
      "icon": "assets/icon.png"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Arena AI",
      "installerLanguages": ["ru", "en"],
      "language": "1049"
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  }
}
